# Copy this file to .env for local Django. Never commit .env.
# Leave LINE values empty until you copy them from the LINE Developers console.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origin allowed to call this API. Comma-separate extras with CORS_ALLOWED_ORIGINS.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=

# LINE Login channel ID. Used as client_id when verifying ID tokens. Not the Messaging API channel ID.
LINE_LOGIN_CHANNEL_ID=

# Messaging API channel secret. Used only to validate X-Line-Signature.
LINE_CHANNEL_SECRET=

# Messaging API long-lived channel access token. Used only to send reply messages.
LINE_CHANNEL_ACCESS_TOKEN=
