# Copy to .env before `npm run dev` or a Cloudflare Pages build.
# Vite reads these at build time. Do not commit .env.

# LIFF ID from the LINE Login channel. Example shape: 1234567890-AbcdEfgh
VITE_LIFF_ID=

# Django origin with no trailing slash.
# Local: http://localhost:8000
# Render: https://ai-agent-line-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000
